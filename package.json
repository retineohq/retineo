{
  "name": "@retineo/memory-core",
  "version": "0.1.0",
  "description": "Persistent epistemic memory core. Clean rewrite per HANDOFF Phase 7.",
  "type": "module",
  "bin": {
    "memory-core": "packages/memory-core/bin/memory-core.js"
  },
  "files": [
    "packages/memory-core/dist",
    "packages/memory-core/bin",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p packages/memory-core/tsconfig.json && cp packages/memory-core/src/adapters/sqlite/schema.sql packages/memory-core/dist/adapters/sqlite/schema.sql",
    "test": "vitest --run packages/memory-core/tests/",
    "lint": "eslint packages/memory-core/src/**/*.ts",
    "validate": "node packages/memory-core/experiments/validate-phase4-5.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.10.0",
    "commander": "^15.0.0",
    "fastify": "^5.8.5",
    "hnswlib-node": "^3.0.0",
    "js-yaml": "^4.2.0",
    "pdfjs-dist": "^6.0.227",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tesseract.js": "^7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/franc": "^5.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.42",
    "@types/pdf-parse": "^1.1.5",
    "@yao-pkg/pkg": "^6.20.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "hono": ">=4.12.27",
      "esbuild": ">=0.28.1",
      "vite": "^6.4.3"
    }
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "knowledge-management",
    "rag",
    "semantic-search",
    "content-compilation",
    "llm",
    "obsidian",
    "local-first"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/retineohq/retineo.git"
  },
  "bugs": {
    "url": "https://github.com/retineohq/retineo/issues"
  },
  "homepage": "https://github.com/retineohq/retineo#readme"
}
