{
  "name": "echo-core",
  "version": "0.1.1",
  "description": "Content Compilation Engine: fractal knowledge compiler (L0-L3)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "echoc": "bin/echo-core.js",
    "echo-core": "bin/echo-core.js",
    "echo-mcp": "bin/echo-mcp.js"
  },
  "files": [
    "dist",
    "bin",
    "packages/core/adapters",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && cp packages/core/src/storage/schema.sql dist/storage/ && cp -r packages/core/adapters dist/adapters",
    "test": "vitest --run",
    "lint": "eslint packages/core/src/**/*.ts",
    "bundle:binary": "esbuild bin/echo-core.js --bundle --platform=node --outfile=dist/bundle.cjs --format=cjs",
    "package:binary": "pnpm bundle:binary && pkg dist/bundle.cjs --out-path=dist --targets=node18-linux-x64,node18-macos-x64,node18-win-x64"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.10.0",
    "commander": "^15.0.0",
    "fastify": "^5.8.5",
    "js-yaml": "^4.2.0",
    "pdfjs-dist": "^6.0.227",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tesseract.js": "^7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/franc": "^5.0.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.42",
    "@types/pdf-parse": "^1.1.5",
    "@yao-pkg/pkg": "^6.20.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "knowledge-management",
    "rag",
    "semantic-search",
    "content-compilation",
    "llm",
    "obsidian",
    "local-first"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/echo-core.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/echo-core/issues"
  },
  "homepage": "https://github.com/your-org/echo-core#readme",
  "publishConfig": {
    "access": "public"
  }
}
